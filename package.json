    "dotenv": "^17.4.2",
    "google-auth-library": "^10.6.2",
    "google-spreadsheet": "^5.2.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
